/*
    DoublyLinkedList<T>: caller `new`s nodes and pushes/inserts them; the
    list deletes them via erase()/clear().

    IntDLL dll;
    IntNode* node = new IntNode(1);
    dll.push_back(node);
    dll.push_front(new IntNode(0));
    dll.insert_at(1, new IntNode(5));   // 0 <= index <= size()
    dll.erase(node);
    dll.clear();
*/

template <class T>
struct DoublyLinkedList {
    struct Node {
        T info;
        Node* prev;
        Node* next;

        Node() : info(), prev(nullptr), next(nullptr) {}
        Node(T _info) : info(_info), prev(nullptr), next(nullptr) {}

        friend ostream& operator<<(ostream& os, const Node* node) {
            if (node == nullptr) return os << "NULL";
            return os << "{info: " << node->info << "}";
        }
    };

    DoublyLinkedList() : siz(0), head(nullptr), tail(nullptr) {}

    void push_back(Node* new_node) {
        assert(new_node != nullptr);
        if (head == nullptr) {
            head = tail = new_node;
        } else {
            tail->next = new_node;
            new_node->prev = tail;
            tail = new_node;
        }
        siz++;
    }

    void push_front(Node* new_node) {
        assert(new_node != nullptr);
        if (head == nullptr) {
            head = tail = new_node;
        } else {
            new_node->next = head;
            head->prev = new_node;
            head = new_node;
        }
        siz++;
    }

    // Inserts `new_node` immediately before `pos_node` (nullptr => append).
    void insert_before(Node* pos_node, Node* new_node) {
        assert(new_node != nullptr);

        if (pos_node == nullptr) {
            push_back(new_node);
            return;
        }
        if (pos_node == head) {
            push_front(new_node);
            return;
        }

        Node* before = pos_node->prev;
        before->next = new_node;
        new_node->prev = before;
        new_node->next = pos_node;
        pos_node->prev = new_node;
        siz++;
    }

    // Inserts `new_node` at 0-based `index` (0 <= index <= size()); walks
    // from whichever end is closer, so O(min(index, size - index)).
    void insert_at(int index, Node* new_node) {
        assert(index >= 0 && index <= siz);
        assert(new_node != nullptr);

        if (index == siz) {
            push_back(new_node);
            return;
        }
        if (index == 0) {
            push_front(new_node);
            return;
        }

        Node* cur;
        if (index <= siz - index) {          // closer to head, walk forward
            cur = head;
            for (int i = 0; i < index; i++) cur = cur->next;
        } else {                             // closer to tail, walk backward
            cur = tail;
            for (int i = siz - 1; i > index; i--) cur = cur->prev;
        }
        insert_before(cur, new_node);
    }

    void erase(Node* del_node) {
        assert(del_node != nullptr);

        if (del_node->prev == nullptr && del_node->next == nullptr) {
            head = tail = nullptr;
        } else if (del_node->prev == nullptr) {
            head = del_node->next;
            head->prev = nullptr;
        } else if (del_node->next == nullptr) {
            tail = del_node->prev;
            tail->next = nullptr;
        } else {
            del_node->prev->next = del_node->next;
            del_node->next->prev = del_node->prev;
        }

        delete del_node;
        siz--;
    }

    void clear() {
        Node* cur = head;
        while (cur) {
            Node* nxt = cur->next;
            delete cur;
            cur = nxt;
        }
        head = tail = nullptr;
        siz = 0;
    }

    Node* get_head() const { return head; }
    Node* get_tail() const { return tail; }
    int size() const { return siz; }
    bool empty() const { return siz == 0; }

    friend ostream& operator<<(ostream& os, const DoublyLinkedList& dll) {
        os << "[ ";
        Node* cur = dll.get_head();
        while (cur != nullptr) {
            os << cur;
            if (cur->next) os << " <-> ";
            cur = cur->next;
        }
        os << " ] (size = " << dll.size() << ")";
        return os;
    }

private:
    Node* head;
    Node* tail;
    int siz;
};

using ll = long long;
using IntDLL = DoublyLinkedList<ll>;
using IntNode = IntDLL::Node;

using VecDLL = DoublyLinkedList<vector<int>>;
using VecNode = VecDLL::Node;

